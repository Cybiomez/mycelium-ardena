# ~/.config/claude-tg/env (права 600) — окружение бота для systemd (EnvironmentFile).
# Создаётся deploy/install.sh. Значения ниже — вымышленные примеры.
CLAUDE_TG_BOT_TOKEN=123456789:EXAMPLE-token-from-vaultwarden
CLAUDE_TG_OWNER_ID=111111111
CLAUDE_TG_HOME_CHAT_ID=-1001234567890
# Необязательные:
# CLAUDE_TG_DATA_DIR=~/.local/share/claude-tg
# CLAUDE_TG_DAEMON_URL=http://127.0.0.1:8787
# CLAUDE_TG_DAEMON_TOKEN_FILE=~/.claude-pocket/token
# CLAUDE_TG_TZ=Europe/Moscow
# CLAUDE_TG_QUIET_FROM=22
# CLAUDE_TG_QUIET_TO=8
# CLAUDE_TG_TGCHAT_SESSION=<id сессии, которую /setup привяжет к теме TGChat>
